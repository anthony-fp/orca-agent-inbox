{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/*.ts", "src/core/*.ts"],
  "exclude": ["src/worker.ts", "src/worker.test.ts", "src/panel.check.ts", "src/panel-views.ts", "src/protocol.ts"]
}
